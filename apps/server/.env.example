# Application
NODE_ENV=development
APP_NAME=College Connect
PORT=3001

# Database (Required)
# Connect to Supabase via Connection Pooling (Port 6543) for Transaction Mode
DATABASE_URL="postgres://postgres.host:6543/postgres?sslmode=require&pgbouncer=true"

# Direct Connection for Migrations (Port 5432)
DIRECT_URL="postgres://postgres.host:5432/postgres?sslmode=require"
SHADOW_DATABASE_URL="postgres://postgres.host:5432/postgres?sslmode=require"

# Supabase Auth & Config
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Authentication
JWT_ACCESS_SECRET=your-super-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional Services
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
OPENAI_API_KEY=
VECTOR_DB_URL=
REDIS_URL=