generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model AdminAuditLog {
  id         String   @id
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

model Assignment {
  id          String       @id
  title       String
  description String?
  dueDate     DateTime?
  points      Int          @default(100)
  classroomId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Classroom   Classroom    @relation(fields: [classroomId], references: [id])
  Submission  Submission[]
}

model AttendanceRecord {
  id          String    @id
  date        DateTime  @default(now())
  classroomId String
  records     Json
  Classroom   Classroom @relation(fields: [classroomId], references: [id])

  @@unique([classroomId, date])
}

model BackgroundJob {
  id           String    @id
  type         JobType
  payload      Json
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?
  scheduledFor DateTime  @default(now())
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([type, status, scheduledFor])
}

model CertificateIssue {
  id                  String              @id
  templateId          String
  userId              String
  eventId             String?
  issuedAt            DateTime            @default(now())
  fileUrl             String
  Event               Event?              @relation(fields: [eventId], references: [id])
  CertificateTemplate CertificateTemplate @relation(fields: [templateId], references: [id])
  User                User                @relation(fields: [userId], references: [id])
}

model CertificateTemplate {
  id               String             @id
  name             String
  fileUrl          String
  fields           String[]
  createdAt        DateTime           @default(now())
  CertificateIssue CertificateIssue[]
}

model Classroom {
  id               String             @id
  name             String
  subject          String?
  description      String?
  code             String             @unique
  bannerUrl        String?
  teacherId        String
  collegeId        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Assignment       Assignment[]
  AttendanceRecord AttendanceRecord[]
  College          College            @relation(fields: [collegeId], references: [id])
  User             User               @relation(fields: [teacherId], references: [id])
  ClassroomMember  ClassroomMember[]
}

model ClassroomMember {
  id          String        @id
  classroomId String
  userId      String
  role        ClassroomRole @default(STUDENT)
  joinedAt    DateTime      @default(now())
  Classroom   Classroom     @relation(fields: [classroomId], references: [id])
  User        User          @relation(fields: [userId], references: [id])

  @@unique([classroomId, userId])
}

model Club {
  id          String       @id
  name        String
  slug        String       @unique
  description String?
  collegeId   String?
  createdAt   DateTime     @default(now())
  type        GroupType    @default(CLUB)
  College     College?     @relation(fields: [collegeId], references: [id])
  ClubMember  ClubMember[]
  Event       Event[]
  Post        Post[]
}

model ClubMember {
  id          String   @id
  userId      String
  clubId      String
  role        ClubRole @default(MEMBER)
  displayRole String?
  joinedAt    DateTime @default(now())
  Club        Club     @relation(fields: [clubId], references: [id])
  User        User     @relation(fields: [userId], references: [id])

  @@unique([userId, clubId])
}

model College {
  id                 String               @id
  name               String
  slug               String               @unique
  city               String?
  state              String?
  createdAt          DateTime             @default(now())
  description        String?
  Classroom          Classroom[]
  Club               Club[]
  Event              Event[]
  MarketplaceListing MarketplaceListing[]
  Note               Note[]
  Post               Post[]
  Profile            Profile[]
}

model Comment {
  id        String   @id
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [authorId], references: [id])
  Post      Post     @relation(fields: [postId], references: [id])
}

model Conversation {
  id                 String              @id
  listingId          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  MarketplaceListing MarketplaceListing? @relation(fields: [listingId], references: [id])
  Message            Message[]
  User               User[]              @relation("UserConversations")
}

model Education {
  id          String    @id
  profileId   String
  school      String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  grade       String?
  description String?
  Profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Event {
  id                    String               @id
  title                 String
  description           String?
  startsAt              DateTime
  endsAt                DateTime
  venue                 String?
  clubId                String?
  collegeId             String?
  createdById           String
  scope                 EventScope           @default(COLLEGE)
  qrToken               String?
  rejectionReason       String?
  attendanceMode        AttendanceMode       @default(SINGLE_SCAN)
  attendancePolicy      String               @default("SINGLE_CHECKIN")
  autoIssueCertificate  Boolean              @default(false)
  category              String?
  certificateEnabled    Boolean              @default(false)
  certificateTemplateId String?
  coverUrl              String?
  createdAt             DateTime             @default(now())
  deletedAt             DateTime?
  noRefundPolicy        Boolean              @default(true)
  onlineLink            String?
  timezone              String               @default("Asia/Kolkata")
  updatedAt             DateTime
  visibility            EventVisibility      @default(PUBLIC)
  waitlistEnabled       Boolean              @default(false)
  status                EventLifecycleStatus @default(DRAFT)
  CertificateIssue      CertificateIssue[]
  Club                  Club?                @relation(fields: [clubId], references: [id])
  College               College?             @relation(fields: [collegeId], references: [id])
  User                  User                 @relation(fields: [createdById], references: [id])
  EventAgendaBlock      EventAgendaBlock[]
  EventAttendance       EventAttendance[]
  EventForm             EventForm?
  EventMemberRole       EventMemberRole[]
  EventMessage          EventMessage[]
  EventRegistration     EventRegistration[]
  SavedItem             SavedItem[]
  TicketType            TicketType[]
  WaitlistEntry         WaitlistEntry[]

  @@index([collegeId])
  @@index([collegeId, startsAt])
  @@index([deletedAt])
  @@index([startsAt])
  @@index([status, startsAt])
}

model EventAgendaBlock {
  id          String   @id
  eventId     String
  day         Int
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  title       String
  description String?
  Event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, day])
}

model EventAttendance {
  id            String         @id
  eventId       String
  userId        String
  status        EventStatus    @default(GOING)
  role          AttendanceRole @default(ATTENDEE)
  checkInMethod String?
  checkInTime   DateTime?
  Event         Event          @relation(fields: [eventId], references: [id])
  User          User           @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventCertificate {
  id                String              @id
  eventId           String
  userId            String
  templateId        String
  fileUrl           String
  issuedAt          DateTime            @default(now())
  EventRegistration EventRegistration[]
}

model EventForm {
  id      String @id
  eventId String @unique
  schema  Json
  Event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventMemberRole {
  id         String        @id
  eventId    String
  userId     String
  role       EventRoleType
  assignedBy String
  createdAt  DateTime      @default(now())
  Event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User       User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventMessage {
  id             String          @id
  eventId        String
  senderId       String
  targetAudience MessageAudience
  subject        String
  body           String
  createdAt      DateTime        @default(now())
  Event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User           User            @relation(fields: [senderId], references: [id])
}

model EventPayment {
  id                 String            @id
  registrationId     String            @unique
  razorpayOrderId    String            @unique
  razorpayPaymentId  String?
  idempotencyKey     String            @unique
  amount             Int
  platformFee        Int
  gatewayFee         Int
  status             PaymentStatus     @default(PENDING)
  webhookProcessedAt DateTime?
  createdAt          DateTime          @default(now())
  capturedAt         DateTime?
  EventRegistration  EventRegistration @relation(fields: [registrationId], references: [id])

  @@index([idempotencyKey])
}

model EventRegistration {
  id               String             @id
  eventId          String
  ticketId         String
  userId           String
  status           RegistrationStatus @default(PENDING)
  paymentId        String?
  amountPaid       Int?
  platformFee      Int?
  gatewayFee       Int?
  checkInTime      DateTime?
  checkOutTime     DateTime?
  checkInBy        String?
  checkInMethod    String?
  checkInDay       Int?
  qrToken          String             @unique
  qrUsed           Boolean            @default(false)
  formResponses    Json?
  certificateId    String?
  deletedAt        DateTime?
  noRefundConsent  Boolean            @default(false)
  createdAt        DateTime           @default(now())
  EventPayment     EventPayment?
  EventCertificate EventCertificate?  @relation(fields: [certificateId], references: [id])
  Event            Event              @relation(fields: [eventId], references: [id])
  TicketType       TicketType         @relation(fields: [ticketId], references: [id])
  User             User               @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([deletedAt])
  @@index([eventId, status])
}

model Experience {
  id          String    @id
  profileId   String
  title       String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  Profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id
  content   String
  category  String
  userId    String?
  collegeId String?
  createdAt DateTime @default(now())
}

model Follows {
  followerId                     String
  followingId                    String
  createdAt                      DateTime @default(now())
  User_Follows_followerIdToUser  User     @relation("Follows_followerIdToUser", fields: [followerId], references: [id])
  User_Follows_followingIdToUser User     @relation("Follows_followingIdToUser", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model MarketplaceListing {
  id           String           @id
  title        String
  description  String?
  price        Int
  imageUrl     String?
  ownerId      String
  collegeId    String?
  scope        MarketplaceScope @default(COLLEGE)
  status       ListingStatus    @default(ACTIVE)
  createdAt    DateTime         @default(now())
  category     String           @default("OTHER")
  type         ListingType      @default(PRODUCT)
  Conversation Conversation[]
  College      College?         @relation(fields: [collegeId], references: [id])
  User         User             @relation(fields: [ownerId], references: [id])
  SavedItem    SavedItem[]
}

model Message {
  id             String       @id
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  seen           Boolean      @default(false)
  seenAt         DateTime?
  Conversation   Conversation @relation(fields: [conversationId], references: [id])
  User           User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
}

model Note {
  id          String      @id
  title       String
  description String?
  fileUrl     String
  subject     String
  semester    Int
  authorId    String
  collegeId   String?
  createdAt   DateTime    @default(now())
  User        User        @relation(fields: [authorId], references: [id])
  College     College?    @relation(fields: [collegeId], references: [id])
  NoteLike    NoteLike[]
  SavedItem   SavedItem[]
}

model NoteLike {
  id     String @id
  noteId String
  userId String
  Note   Note   @relation(fields: [noteId], references: [id])
  User   User   @relation(fields: [userId], references: [id])

  @@unique([noteId, userId])
}

model Notification {
  id        String           @id
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  actionUrl String?
  actorId   String?
  createdAt DateTime         @default(now())
  User      User             @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([userId, read])
}

model PaymentWebhookLog {
  id                String   @id
  razorpayOrderId   String
  razorpayPaymentId String?
  eventType         String
  payload           Json
  processedAt       DateTime @default(now())

  @@index([razorpayOrderId])
}

model Poll {
  id         String       @id
  question   String
  endDate    DateTime?
  createdAt  DateTime     @default(now())
  PollOption PollOption[]
  PollVote   PollVote[]
  Post       Post[]
}

model PollOption {
  id       String     @id
  text     String
  pollId   String
  Poll     Poll       @relation(fields: [pollId], references: [id])
  PollVote PollVote[]
}

model PollVote {
  id         String     @id
  userId     String
  optionId   String
  pollId     String
  createdAt  DateTime   @default(now())
  PollOption PollOption @relation(fields: [optionId], references: [id])
  Poll       Poll       @relation(fields: [pollId], references: [id])
  User       User       @relation(fields: [userId], references: [id])

  @@unique([userId, pollId])
}

model Post {
  id          String         @id
  content     String
  imageUrl    String?
  authorId    String?
  collegeId   String?
  clubId      String?
  isAnonymous Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime
  pollId      String?
  title       String?
  type        PostType       @default(TEXT)
  visibility  PostVisibility @default(PUBLIC)
  Comment     Comment[]
  User        User?          @relation(fields: [authorId], references: [id])
  Club        Club?          @relation(fields: [clubId], references: [id])
  College     College?       @relation(fields: [collegeId], references: [id])
  Poll        Poll?          @relation(fields: [pollId], references: [id])
  PostLike    PostLike[]
  SavedItem   SavedItem[]

  @@index([authorId])
  @@index([collegeId, createdAt])
  @@index([collegeId])
  @@index([createdAt])
}

model PostLike {
  id     String @id
  postId String
  userId String
  Post   Post   @relation(fields: [postId], references: [id])
  User   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Profile {
  id             String         @id
  userId         String         @unique
  fullName       String
  collegeId      String?
  bio            String?
  avatarUrl      String?
  tags           String[]
  githubUrl      String?
  instagram      String?
  socials        Json?
  interests      String[]
  isOnboarded    Boolean        @default(false)
  onboardingStep Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  linkedin       String?
  points         Int            @default(0)
  
  // UX personalization field (separate from permission role)
  userType       UserType?
  
  Education      Education[]
  Experience     Experience[]
  College        College?       @relation(fields: [collegeId], references: [id])
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project        Project[]
  Volunteering   Volunteering[]
}

model Project {
  id          String    @id
  profileId   String
  title       String
  description String?
  imageUrl    String?
  link        String?
  tags        String[]
  startDate   DateTime?
  endDate     DateTime?
  Profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SavedItem {
  id                 String              @id
  userId             String
  type               SavedType
  postId             String?
  eventId            String?
  listingId          String?
  noteId             String?
  createdAt          DateTime            @default(now())
  Event              Event?              @relation(fields: [eventId], references: [id])
  MarketplaceListing MarketplaceListing? @relation(fields: [listingId], references: [id])
  Note               Note?               @relation(fields: [noteId], references: [id])
  Post               Post?               @relation(fields: [postId], references: [id])
  User               User                @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@unique([userId, listingId])
  @@unique([userId, noteId])
  @@unique([userId, postId])
}

model Submission {
  id           String           @id
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(PENDING)
  fileUrl      String?
  grade        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime
  Assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  User         User             @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

model TicketType {
  id                String              @id
  eventId           String
  name              String
  description       String?
  price             Int                 @default(0)
  quantity          Int?
  quantitySold      Int                 @default(0)
  perUserLimit      Int                 @default(1)
  salesStart        DateTime?
  salesEnd          DateTime?
  EventRegistration EventRegistration[]
  Event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  WaitlistEntry     WaitlistEntry[]

  @@index([eventId])
}

model User {
  id                                String               @id
  email                             String?              @unique
  password                          String?
  role                              Role                 @default(STUDENT)
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime
  hashedRefreshToken                String?
  supabaseId                        String?              @unique
  CertificateIssue                  CertificateIssue[]
  Classroom                         Classroom[]
  ClassroomMember                   ClassroomMember[]
  ClubMember                        ClubMember[]
  Comment                           Comment[]
  Event                             Event[]
  EventAttendance                   EventAttendance[]
  EventMemberRole                   EventMemberRole[]
  EventMessage                      EventMessage[]
  EventRegistration                 EventRegistration[]
  Follows_Follows_followerIdToUser  Follows[]            @relation("Follows_followerIdToUser")
  Follows_Follows_followingIdToUser Follows[]            @relation("Follows_followingIdToUser")
  MarketplaceListing                MarketplaceListing[]
  Message                           Message[]
  Note                              Note[]
  NoteLike                          NoteLike[]
  Notification                      Notification[]
  PollVote                          PollVote[]
  Post                              Post[]
  PostLike                          PostLike[]
  Profile                           Profile?
  SavedItem                         SavedItem[]
  Submission                        Submission[]
  WaitlistEntry                     WaitlistEntry[]
  Conversation                      Conversation[]       @relation("UserConversations")

  @@index([supabaseId])
}

model Volunteering {
  id           String    @id
  profileId    String
  role         String
  organization String
  startDate    DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?
  link         String?
  Profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id         String         @id
  eventId    String
  ticketId   String
  userId     String
  position   Int
  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  Event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  TicketType TicketType     @relation(fields: [ticketId], references: [id])
  User       User           @relation(fields: [userId], references: [id])

  @@unique([eventId, ticketId, userId])
  @@index([eventId, ticketId, position])
}

enum AttendanceMode {
  SINGLE_SCAN
  ENTRY_EXIT
}

enum AttendanceRole {
  ATTENDEE
  VOLUNTEER
  SPEAKER
}

enum ClassroomRole {
  TEACHER
  STUDENT
}

enum ClubRole {
  MEMBER
  LEAD
  STAFF
}

enum EventLifecycleStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EventRoleType {
  CREATOR
  CO_ORGANIZER
  HEAD
  VOLUNTEER
}

enum EventScope {
  COLLEGE
  GLOBAL
}

enum EventStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum EventVisibility {
  PUBLIC
  INVITE_ONLY
}

enum GroupType {
  CLUB
  COMMUNITY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum JobType {
  CERTIFICATE_GENERATION
  NOTIFICATION_DISPATCH
  REMINDER_SEND
  DATA_CLEANUP
  WAITLIST_NOTIFY
}

enum ListingStatus {
  ACTIVE
  SOLD
  HIDDEN
}

enum ListingType {
  PRODUCT
  SERVICE
  JOB
}

enum MarketplaceScope {
  COLLEGE
  STATE
}

enum MessageAudience {
  ALL_REGISTRANTS
  CHECKED_IN
  VOLUNTEERS
  HEADS
}

enum NotificationType {
  LIKE
  COMMENT
  EVENT
  MESSAGE
  SYSTEM
  FOLLOW
  CLASSROOM
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PostType {
  TEXT
  MEDIA
  POLL
  COLLAB
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  COLLEGE
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  ATTENDED
}

enum Role {
  STUDENT
  CLUB_ADMIN
  COLLEGE_ADMIN
  PLATFORM_ADMIN
  FACULTY
}

// UX personalization type (separate from permission Role)
enum UserType {
  STUDENT
  PROFESSIONAL
  ORGANIZER
  TEACHER
}

enum SavedType {
  POST
  EVENT
  LISTING
  NOTE
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  MISSING
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CLAIMED
  EXPIRED
}
