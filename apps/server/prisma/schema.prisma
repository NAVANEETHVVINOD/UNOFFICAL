generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String?              @unique
  password           String?
  role               Role                 @default(STUDENT)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  hashedRefreshToken String?
  supabaseId         String?              @unique
  certificates       CertificateIssue[]
  memberships        ClubMember[]
  comments           Comment[]
  createdEvents      Event[]
  events             EventAttendance[]
  listings           MarketplaceListing[] @relation("ListingOwner")
  sentMessages       Message[]            @relation("SentMessages")
  notes              Note[]               @relation("AuthorNotes")
  likes              NoteLike[]
  posts              Post[]
  postLikes          PostLike[]
  pollVotes          PollVote[]
  profile            Profile?
  conversations      Conversation[]       @relation("UserConversations")
  savedItems         SavedItem[]
  notifications      Notification[]


  followers Follows[] @relation("following")
  following Follows[] @relation("follower")

  // LMS Relations
  teachingClassrooms Classroom[]       @relation("TeacherClassrooms")
  joinedClassrooms   ClassroomMember[]
  submissions        Submission[]

  @@index([supabaseId])
}

model Follows {
  follower    User   @relation("follower", fields: [followerId], references: [id])
  followerId  String
  following   User   @relation("following", fields: [followingId], references: [id])
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  fullName       String
  collegeId      String?
  bio            String?
  avatarUrl      String?
  tags           String[]
  githubUrl      String?
  instagram      String?
  socials        Json?
  interests      String[]
  isOnboarded    Boolean  @default(false)
  onboardingStep Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  linkedin       String?
  points         Int      @default(0)
  college        College? @relation(fields: [collegeId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  education      Education[]
  experience     Experience[]
  projects       Project[]
  volunteering   Volunteering[]
}

model Education {
  id          String   @id @default(cuid())
  profileId   String
  school      String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  grade       String?
  description String?
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String?
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String?
  imageUrl    String?
  link        String?
  tags        String[]
  startDate   DateTime?
  endDate     DateTime?
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Volunteering {
  id           String   @id @default(cuid())
  profileId    String
  role         String
  organization String
  startDate    DateTime
  endDate      DateTime?
  current      Boolean  @default(false)
  description  String?
  link         String?
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model College {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  city      String?
  state     String?
  description String?  @db.Text
  createdAt DateTime             @default(now())
  clubs     Club[]
  events    Event[]
  listings  MarketplaceListing[]
  notes     Note[]
  posts     Post[]
  profiles  Profile[]
  classrooms Classroom[]
}

model Club {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  collegeId   String?
  type        GroupType    @default(CLUB)
  createdAt   DateTime     @default(now())
  college     College?     @relation(fields: [collegeId], references: [id])
  members     ClubMember[]
  events      Event[]
  posts       Post[]
}

enum GroupType {
  CLUB
  COMMUNITY
}

model ClubMember {
  id          String   @id @default(cuid())
  userId      String
  clubId      String
  role        ClubRole @default(MEMBER)
  displayRole String?
  joinedAt    DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, clubId])
}

model Event {
  id           String             @id @default(cuid())
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  venue        String?
  clubId       String?
  collegeId    String?
  createdById  String
  scope        EventScope         @default(COLLEGE)
  
  // Approval
  status          EventApprovalStatus @default(PENDING)
  rejectionReason String?

  qrToken      String?
  certificates CertificateIssue[]
  club         Club?              @relation(fields: [clubId], references: [id])
  college      College?           @relation(fields: [collegeId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
  attendees    EventAttendance[]
  savedBy      SavedItem[]
}

model EventAttendance {
  id            String         @id @default(cuid())
  eventId       String
  userId        String
  status        EventStatus    @default(GOING)
  role          AttendanceRole @default(ATTENDEE)
  checkInMethod String?
  checkInTime   DateTime?
  event         Event          @relation(fields: [eventId], references: [id])
  user          User           @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model MarketplaceListing {
  id            String           @id @default(cuid())
  title         String
  description   String?
  price         Int
  imageUrl      String?
  ownerId       String
  collegeId     String?
  scope         MarketplaceScope @default(COLLEGE)
  status        ListingStatus    @default(ACTIVE)
  type          ListingType      @default(PRODUCT)
  createdAt     DateTime         @default(now())
  category      String           @default("OTHER")
  conversations Conversation[]
  college       College?         @relation(fields: [collegeId], references: [id])
  owner         User             @relation("ListingOwner", fields: [ownerId], references: [id])
  savedBy       SavedItem[]
}

model Note {
  id          String     @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  subject     String
  semester    Int
  authorId    String
  collegeId   String?
  createdAt   DateTime   @default(now())
  author      User       @relation("AuthorNotes", fields: [authorId], references: [id])
  college     College?   @relation(fields: [collegeId], references: [id])
  likes       NoteLike[]
  savedBy     SavedItem[]
}

model NoteLike {
  id     String @id @default(cuid())
  noteId String
  userId String
  note   Note   @relation(fields: [noteId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([noteId, userId])
}

enum PostType {
  TEXT
  MEDIA
  POLL
  COLLAB
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  COLLEGE
}

model Post {
  id          String          @id @default(cuid())
  type        PostType        @default(TEXT)
  visibility  PostVisibility  @default(PUBLIC)
  title       String?   // for collab posts
  content     String
  imageUrl    String?   

  pollId      String?
  isAnonymous Boolean   @default(false)

  authorId    String?
  collegeId   String?
  clubId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  comments    Comment[]
  author      User?     @relation(fields: [authorId], references: [id])
  club        Club?     @relation(fields: [clubId], references: [id])
  college     College?  @relation(fields: [collegeId], references: [id])
  likes       PostLike[]
  poll        Poll?     @relation(fields: [pollId], references: [id])
  savedBy     SavedItem[]
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  endDate   DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]
  posts     Post[]
}

model PollOption {
  id     String     @id @default(cuid())
  text   String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id])
  votes  PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  userId    String
  optionId  String
  pollId    String
  createdAt DateTime @default(now())
  
  poll      Poll       @relation(fields: [pollId], references: [id])
  option    PollOption @relation(fields: [optionId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@unique([userId, pollId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  category  String
  userId    String?
  collegeId String?
  createdAt DateTime @default(now())
}

model CertificateTemplate {
  id        String             @id @default(cuid())
  name      String
  fileUrl   String
  fields    String[]
  createdAt DateTime           @default(now())
  issues    CertificateIssue[]
}

model CertificateIssue {
  id         String              @id @default(cuid())
  templateId String
  userId     String
  eventId    String?
  issuedAt   DateTime            @default(now())
  fileUrl    String
  event      Event?              @relation(fields: [eventId], references: [id])
  template   CertificateTemplate @relation(fields: [templateId], references: [id])
  user       User                @relation(fields: [userId], references: [id])
}

model Conversation {
  id           String              @id @default(cuid())
  listingId    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  listing      MarketplaceListing? @relation(fields: [listingId], references: [id])
  messages     Message[]
  participants User[]              @relation("UserConversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  seen           Boolean      @default(false)
  seenAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
}

enum Role {
  STUDENT
  FACULTY
  CLUB_ADMIN
  COLLEGE_ADMIN
  PLATFORM_ADMIN
}

enum ClubRole {
  MEMBER
  LEAD
  STAFF
}

enum EventStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum EventApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  ACTIVE
  SOLD
  HIDDEN
}

enum ListingType {
  PRODUCT
  SERVICE
  JOB
}

enum EventScope {
  COLLEGE
  STATE
}

enum MarketplaceScope {
  COLLEGE
  STATE
}

enum AttendanceRole {
  ATTENDEE
  VOLUNTEER
  SPEAKER
}

model SavedItem {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  
  type      SavedType
  
  postId    String?
  post      Post?              @relation(fields: [postId], references: [id])
  
  eventId   String?
  event     Event?             @relation(fields: [eventId], references: [id])
  
  listingId String?
  listing   MarketplaceListing? @relation(fields: [listingId], references: [id])
  
  noteId    String?
  note      Note?              @relation(fields: [noteId], references: [id])
  
  createdAt DateTime           @default(now())

  @@unique([userId, postId])
  @@unique([userId, eventId])
  @@unique([userId, listingId])
  @@unique([userId, noteId])
}


enum SavedType {
  POST
  EVENT
  LISTING
  NOTE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  actionUrl String?
  actorId   String? // User who triggered the notification
  createdAt DateTime         @default(now())
}

enum NotificationType {
  LIKE
  COMMENT
  EVENT
  MESSAGE
  SYSTEM
  FOLLOW
  CLASSROOM
}

// -------------------- LMS (Learning Management System) --------------------

model Classroom {
  id          String   @id @default(cuid())
  name        String
  subject     String?
  description String?  @db.Text
  code        String   @unique // Unique join code
  bannerUrl   String?
  
  teacherId   String
  collegeId   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User     @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  college     College  @relation(fields: [collegeId], references: [id])
  
  members     ClassroomMember[]
  assignments Assignment[]
  attendance  AttendanceRecord[]
}

model ClassroomMember {
  id          String        @id @default(cuid())
  classroomId String
  userId      String
  role        ClassroomRole @default(STUDENT)
  joinedAt    DateTime      @default(now())

  classroom   Classroom     @relation(fields: [classroomId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@unique([classroomId, userId])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  points      Int      @default(100)
  
  classroomId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom   Classroom     @relation(fields: [classroomId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  
  status       SubmissionStatus @default(PENDING)
  fileUrl      String?
  grade        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  student      User             @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  date        DateTime @default(now()) // Can be just date part
  classroomId String
  
  // JSON structure: { "userId": "status", "userId2": "status" }
  // Status: PRESENT, ABSENT, LATE, EXCUSED
  records     Json 

  classroom   Classroom @relation(fields: [classroomId], references: [id])

  @@unique([classroomId, date])
}

enum ClassroomRole {
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  MISSING
}
