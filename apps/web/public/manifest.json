{
    "name": "LINKER - The Campus Collective",
    "short_name": "LINKER",
    "description": "Connect with your campus community. Events, clubs, marketplace, and more.",
    "start_url": "/dashboard",
    "display": "standalone",
    "background_color": "#FDF6E3",
    "theme_color": "#0D0D0D",
    "orientation": "portrait-primary",
    "scope": "/",
    "lang": "en",
    "id": "/",
    "categories": ["social", "education", "lifestyle"],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-192-maskable.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ],
    "shortcuts": [
        {
            "name": "Events",
            "short_name": "Events",
            "description": "View campus events",
            "url": "/events",
            "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
        },
        {
            "name": "Marketplace",
            "short_name": "Market",
            "description": "Buy and sell items",
            "url": "/marketplace",
            "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
        },
        {
            "name": "Messages",
            "short_name": "Chat",
            "description": "View your messages",
            "url": "/messages",
            "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
        },
        {
            "name": "Explore",
            "short_name": "Explore",
            "description": "Discover campus content",
            "url": "/explore",
            "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
        }
    ],
    "related_applications": [],
    "handle_links": "preferred",
    "launch_handler": {
        "client_mode": "navigate-existing"
    }
}